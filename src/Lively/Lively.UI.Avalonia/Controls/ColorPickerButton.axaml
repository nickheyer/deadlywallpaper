<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lively.UI.Avalonia.Localization"
             x:Class="Lively.UI.Avalonia.Controls.ColorPickerButton"
             x:Name="Root">
  <StackPanel Orientation="Horizontal" Spacing="5">
    <DropDownButton Padding="0,0,5,0">
      <Border MinWidth="31"
              MinHeight="31"
              Margin="1"
              CornerRadius="5"
              Background="{Binding #Root.SelectedBrush}" />
      <DropDownButton.Flyout>
        <Flyout Placement="Bottom">
          <ColorView Color="{Binding #Root.PickerColor, Mode=TwoWay}"
                     ColorSpectrumShape="Box"
                     IsAlphaEnabled="False"
                     IsAlphaVisible="False"
                     IsColorPaletteVisible="False"
                     IsAccentColorsVisible="False"
                     IsHexInputVisible="True"
                     IsComponentTextInputVisible="True"
                     IsColorSpectrumSliderVisible="True" />
        </Flyout>
      </DropDownButton.Flyout>
    </DropDownButton>
    <Button VerticalAlignment="Stretch"
            Command="{Binding #Root.OpenEyeDropperCommand}"
            ToolTip.Tip="{loc:Str TextEyeDropper}">
      <PathIcon Width="14" Height="14" Data="{DynamicResource IconEyeDropper}" />
    </Button>
  </StackPanel>
</UserControl>
