<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Lively.UI.Avalonia.Converters"
             xmlns:loc="using:Lively.UI.Avalonia.Localization"
             xmlns:vm="using:Lively.UI.Shared.ViewModels"
             x:Class="Lively.UI.Avalonia.Views.Gallery.ManageAccountView"
             x:DataType="vm:ManageAccountViewModel"
             MinWidth="400"
             MinHeight="400">
  <Panel>
    <Image conv:ImageLoader.Source="avares://Lively.UI.Avalonia/Assets/banner-lively-1080.jpg" Stretch="UniformToFill" />
    <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}" />
    <StackPanel Margin="50" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="8">
      <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}" HorizontalAlignment="Center">
        <Panel>
          <PathIcon Width="48" Height="48" Data="{DynamicResource IconContact}" IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNull}}" />
          <Image conv:ImageLoader.UriSource="{Binding Picture}" Stretch="UniformToFill" />
        </Panel>
      </Border>
      <TextBlock Margin="0,0,0,10" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding DisplayName}" />
      <StackPanel Spacing="10" IsVisible="{Binding IsProcessing, Converter={x:Static BoolConverters.Not}}">
        <Button Width="175" Height="35" HorizontalContentAlignment="Center" Command="{Binding ExportAccountCommand}" Content="{loc:Str GalleryAccountExport/Content}" />
        <Button Width="175" Height="35" HorizontalContentAlignment="Center" Command="{Binding LogoutAccountCommand}" Content="{loc:Str GalleryAccountLogout/Content}" />
        <Button Classes="danger" Width="175" Height="35" Margin="0,15,0,0" HorizontalContentAlignment="Center" Command="{Binding DeleteAccountCommand}" Content="{loc:Str GalleryAccountDelete/Content}" />
      </StackPanel>
    </StackPanel>
  </Panel>
</UserControl>
