<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Lively.UI.Avalonia.Controls"
        xmlns:conv="using:Lively.UI.Avalonia.Converters"
        xmlns:loc="using:Lively.UI.Avalonia.Localization"
        xmlns:models="using:Lively.Models.UserControls"
        xmlns:vm="using:Lively.UI.Shared.ViewModels"
        x:Class="Lively.UI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Title="Lively Wallpaper"
        Width="875"
        Height="875"
        MinWidth="700"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Panel>
    <!-- Custom background -->
    <Image conv:ImageLoader.Source="{Binding AppThemeBackground}"
           Stretch="UniformToFill"
           IsVisible="{Binding AppThemeBackground, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
            IsVisible="{Binding AppThemeBackground, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid x:Name="ContentRoot" RowDefinitions="Auto,*" IsVisible="False">
      <!-- Navigation. The title bar is the compositor's own (icon and title come from the window);
           the search box sits between the tabs and the toolbar. -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,8,8,4">
        <Button Grid.Column="0"
                Classes="toolbar"
                Command="{Binding OpenHomeCommand}"
                IsVisible="{Binding IsSettingsPage}"
                ToolTip.Tip="{loc:Str TextBack}">
          <PathIcon Width="16" Height="16" Data="{DynamicResource IconArrowLeft}" />
        </Button>
        <controls:NavigationList Grid.Column="1"
                                 Classes="navigation"
                                 ItemsSource="{Binding MenuItems}"
                                 SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                                 IsSettingsPage="{Binding IsSettingsPage}">
          <controls:NavigationList.ItemTemplate>
            <DataTemplate x:DataType="models:MainNavigationItem">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="16"
                          Height="16"
                          Data="{Binding PageType, Converter={StaticResource PageTypeToIconConverter}}"
                          IsVisible="{Binding Glyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="8"
                        MinWidth="16"
                        Height="16"
                        Padding="4,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsAlert}">
                  <TextBlock Text="{Binding Alert}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </StackPanel>
            </DataTemplate>
          </controls:NavigationList.ItemTemplate>
        </controls:NavigationList>
        <!-- Library search -->
        <TextBox x:Name="SearchBox"
                 x:DataType="vm:LibraryViewModel"
                 Grid.Column="2"
                 MinWidth="180"
                 MaxWidth="360"
                 Margin="8,0"
                 VerticalAlignment="Center"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 Watermark="{Binding #Root.((vm:MainViewModel)DataContext).SearchPlaceholderText}"
                 IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsSettingsPage, Converter={x:Static BoolConverters.Not}}">
          <TextBox.InnerRightContent>
            <PathIcon Width="14" Height="14" Margin="0,0,8,0" Opacity="0.7" Data="{DynamicResource IconSearch}" />
          </TextBox.InnerRightContent>
        </TextBox>
        <!-- Footer -->
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="2"
                    IsVisible="{Binding IsSettingsPage, Converter={x:Static BoolConverters.Not}}">
          <!-- Add Wallpaper -->
          <Button Classes="toolbar" Command="{Binding OpenAddWallpaperCommand}" ToolTip.Tip="{loc:Str AddWallpaperDrop/Text}">
            <PathIcon Width="16" Height="16" Data="{DynamicResource IconAdd}" />
          </Button>
          <!-- Control Panel -->
          <Button Classes="toolbar" Command="{Binding OpenControlPanelCommand}" ToolTip.Tip="{Binding WallpaperCountMessage}">
            <TextBlock x:Name="ControlPanelIcon"
                       FontFamily="{StaticResource CustomIconFonts}"
                       FontSize="16"
                       Text="{Binding WallpaperCountGlyph}" />
          </Button>
          <!-- Patreon -->
          <Button Classes="toolbar" Command="{Binding OpenPatreonCommand}" ToolTip.Tip="Patreon">
            <TextBlock FontFamily="{StaticResource CustomIconFonts}" FontSize="16" Text="&#xE90B;" />
          </Button>
          <Rectangle Width="1" Height="20" Margin="4,0" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
          <!-- Settings -->
          <Button Classes="toolbar" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{loc:Str TitleSettings}">
            <PathIcon Width="16" Height="16" Data="{DynamicResource IconSettings}" />
          </Button>
          <!-- Secondary menu -->
          <Button Classes="toolbar">
            <PathIcon Width="16" Height="16" Data="{DynamicResource IconMore}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{loc:Str Theme/Label}" Command="{Binding OpenAppThemeCommand}">
                  <MenuItem.Icon>
                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconTheme}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:Str Help/Label}" Command="{Binding OpenHelpCommand}">
                  <MenuItem.Icon>
                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconHelp}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:Str About/Label}" Command="{Binding OpenAboutCommand}">
                  <MenuItem.Icon>
                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconInfo}" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Content -->
      <Panel Grid.Row="1">
        <ContentControl x:Name="ContentFrame" />
        <StackPanel VerticalAlignment="Top" Margin="8,4" Spacing="4">
          <!-- Show Errors -->
          <controls:InfoBar Title="{Binding ErrorNotification.Title}"
                            IsOpen="{Binding ErrorNotification.IsOpen, Mode=TwoWay}"
                            Severity="Error">
            <StackPanel Margin="0,0,0,10" Spacing="5">
              <ScrollViewer MaxHeight="300">
                <TextBlock Text="{Binding ErrorNotification.Message}" TextWrapping="Wrap" />
              </ScrollViewer>
              <HyperlinkButton NavigateUri="https://github.com/rocksdanister/lively/wiki/Common-Problems" Content="{loc:Str TextLearnMore/Text}" />
            </StackPanel>
          </controls:InfoBar>
          <!-- WebView2 Installation -->
          <controls:InfoBar Title="{loc:Str WebViewRequired/Title}"
                            Message="{loc:Str WebViewRequired/Message}"
                            IsClosable="{Binding IsWebView2Installing, Converter={x:Static BoolConverters.Not}}"
                            IsOpen="{Binding IsWebView2InstallNotify, Mode=TwoWay}"
                            Severity="Warning">
            <controls:InfoBar.ActionButton>
              <Button Content="{loc:Str TitleDownload/Content}" Command="{Binding InstallWebView2Command}" />
            </controls:InfoBar.ActionButton>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsWebView2Installing}" />
          </controls:InfoBar>
          <!-- Show Wallpaper Import Progress -->
          <controls:InfoBar Title="{Binding ImportNotification.Title}"
                            Message="{Binding ImportNotification.Message}"
                            IsClosable="False"
                            IsOpen="{Binding ImportNotification.IsOpen}"
                            Severity="Informational">
            <controls:InfoBar.ActionButton>
              <Button Content="{loc:Str Cancel/Content}" Command="{Binding AddWallpapersCancelCommand}" />
            </controls:InfoBar.ActionButton>
            <ProgressBar Maximum="100"
                         IsIndeterminate="{Binding ImportNotification.IsProgressIndeterminate}"
                         Value="{Binding ImportNotification.Progress}" />
          </controls:InfoBar>
          <!-- Screensaver selection mode -->
          <controls:InfoBar x:Name="SelectionBar"
                            x:DataType="vm:LibraryViewModel"
                            IsOpen="{Binding IsSelectionOnlyMode}"
                            CloseButtonCommand="{Binding SelectItemCancelCommand}"
                            Message="{loc:Str SelectScreensaverCustomMode/Text}"
                            Severity="Informational" />
          <!-- Updated notification -->
          <controls:InfoBar IsOpen="{Binding IsUpdatedNotify}"
                            Title="{loc:Str UpdateCompleted/Text}"
                            Severity="Success">
            <controls:InfoBar.ActionButton>
              <HyperlinkButton Content="{loc:Str UpdateWhatsNew/Text}" Command="{Binding OpenUpdateCommand}" />
            </controls:InfoBar.ActionButton>
          </controls:InfoBar>
          <!-- Control panel teaching tip -->
          <controls:InfoBar IsOpen="{Binding IsControlPanelTeachingTipOpen}"
                            Title="{loc:Str ControlPanel/Title}"
                            Message="{loc:Str ControlPanel/Subtitle}"
                            Severity="Informational" />
        </StackPanel>
      </Panel>
    </Grid>

    <!-- Core connection state -->
    <Border x:Name="CoreStatePanel">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="520">
        <PathIcon x:Name="CoreStateIcon"
                  Width="48"
                  Height="48"
                  Foreground="{DynamicResource SystemFillColorCautionBrush}"
                  Data="{DynamicResource IconWarning}" />
        <TextBlock x:Name="CoreStateTitle"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="CoreStateMessage"
                   Classes="secondary"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="CoreStateDetails"
                   Classes="caption"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <ProgressBar x:Name="CoreStateProgress" IsIndeterminate="True" Width="240" HorizontalAlignment="Center" />
        <Button x:Name="RetryButton"
                Classes="accent"
                HorizontalAlignment="Center"
                MinWidth="120"
                HorizontalContentAlignment="Center"
                Content="{loc:Str TextRetry}"
                Click="RetryButton_Click" />
      </StackPanel>
    </Border>

    <controls:DialogHost x:Name="DialogHostControl" />
  </Panel>
</Window>
