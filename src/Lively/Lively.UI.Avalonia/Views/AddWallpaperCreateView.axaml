<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Lively.UI.Avalonia.Converters"
             xmlns:models="using:Lively.Models"
             xmlns:vm="using:Lively.UI.Shared.ViewModels"
             x:Class="Lively.UI.Avalonia.Views.AddWallpaperCreateView"
             x:DataType="vm:AddWallpaperCreateViewModel">
  <ListBox Classes="rows"
           MinWidth="500"
           MinHeight="350"
           MaxWidth="500"
           MaxHeight="400"
           Padding="0,5,0,0"
           ItemsSource="{Binding WallpaperCategoriesFiltered}"
           SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="models:AddWallpaperCreateModel">
        <Grid MinHeight="50" MaxHeight="50" ColumnDefinitions="50,*">
          <Border Grid.Column="0" Margin="5" CornerRadius="5" ClipToBounds="True">
            <Image conv:ImageLoader.Source="{Binding Icon}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Classes="body" MaxLines="1" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
            <TextBlock Classes="caption" Margin="0,2.5,0,0" MaxLines="1" TextTrimming="CharacterEllipsis" Text="{Binding Description}" />
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
