<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Lively.UI.Avalonia.Converters"
             xmlns:loc="using:Lively.UI.Avalonia.Localization"
             xmlns:vm="using:Lively.UI.Shared.ViewModels"
             x:Class="Lively.UI.Avalonia.Views.AddWallpaperDataView"
             x:DataType="vm:AddWallpaperDataViewModel">
  <ScrollViewer>
    <StackPanel MinWidth="340">
      <Border Width="288"
              Height="162"
              Margin="10,0,25,10"
              HorizontalAlignment="Left"
              CornerRadius="5"
              ClipToBounds="True"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              IsVisible="{Binding Model.ImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Image conv:ImageLoader.Source="{Binding Model.ImagePath}" Stretch="UniformToFill" />
      </Border>

      <TextBlock Text="{loc:Str Title/Text}" />
      <TextBox MinWidth="300"
               MaxWidth="300"
               Margin="10,5,25,10"
               HorizontalAlignment="Left"
               IsEnabled="{Binding IsUserEditable}"
               Text="{Binding Title, Mode=TwoWay}" />

      <TextBlock Text="{loc:Str Description/Text}" />
      <TextBox Height="81"
               MinWidth="300"
               MaxWidth="300"
               Margin="10,5,25,10"
               HorizontalAlignment="Left"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               IsEnabled="{Binding IsUserEditable}"
               Text="{Binding Desc, Mode=TwoWay}" />

      <TextBlock Text="{loc:Str Author/Text}" />
      <TextBox MinWidth="300"
               MaxWidth="300"
               Margin="10,5,25,10"
               HorizontalAlignment="Left"
               IsEnabled="{Binding IsUserEditable}"
               Text="{Binding Author, Mode=TwoWay}" />

      <TextBlock Text="{loc:Str SourceWebsite/Text}" />
      <TextBox MinWidth="300"
               MaxWidth="300"
               Margin="10,5,25,0"
               HorizontalAlignment="Left"
               IsEnabled="{Binding IsUserEditable}"
               Text="{Binding Url, Mode=TwoWay}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
