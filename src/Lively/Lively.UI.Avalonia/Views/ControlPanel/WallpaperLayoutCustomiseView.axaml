<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lively.UI.Avalonia.Views.ControlPanel.WallpaperLayoutCustomiseView">
  <Border Padding="25" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}" CornerRadius="5">
    <ContentControl x:Name="ContentFrame" Margin="0,5,0,5" HorizontalAlignment="Stretch" />
  </Border>
</UserControl>
